# Copy to .env.docker (done by scripts/init-docker-env.sh, which also generates secrets).
# Never commit .env.docker or the secrets/ directory.

# Browser-facing origin of the frontend gateway (scheme://host[:port], no trailing slash).
# Change this (and rebuild the frontend) for a server deployment, e.g. https://lms.example.edu
PUBLIC_ORIGIN=http://localhost:3000

# Published port/bind of the ONLY externally reachable service (the nginx frontend gateway).
# Use FRONTEND_BIND=0.0.0.0 on a server, or keep 127.0.0.1 behind a TLS reverse proxy.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

# OAuth-style LMS client registered in Central Identity (see docs/deployment-and-demo-guide.md).
LMS_CLIENT_ID=g11-lms

# Sibling repository build contexts (relative to this directory).
CENTRAL_IDENTITY_CONTEXT=../co3103-g11-central-identity
FRONTEND_CONTEXT=../co3103-g11-frontend

# Databases (passwords generated by init script).
CI_DB_NAME=central_identity
CI_DB_USER=identity_app
CI_DB_PASSWORD=
LMS_DB_NAME=lms
LMS_DB_USER=lms_app
LMS_DB_PASSWORD=

# Optional SMTP for password-recovery e-mail. Empty disables real delivery.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
APP_RESET_PASSWORD_BASE_URL=http://localhost:3000/reset-password

# Optional Maven repository mirrors for image builds (empty = Maven Central).
# MVNW_REPOURL serves the Maven Wrapper distribution (sha256 pinned in the Dockerfile);
# MAVEN_MIRROR_URL serves dependencies (checksums enforced with --strict-checksums).
# Example when Central returns HTTP 429: https://maven-central.storage-download.googleapis.com/maven2
MVNW_REPOURL=
MAVEN_MIRROR_URL=
